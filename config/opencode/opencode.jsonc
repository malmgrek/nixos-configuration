{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "spar-and-plan",
  "model": "github-copilot/claude-sonnet-4.5",
  "share": "disabled",

  "permission": {
    "*": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },

  // "theme": "tokyonight",
  "theme": "one-dark",

  "compaction": {
    "auto": true,
    "prune": true
  }
}
